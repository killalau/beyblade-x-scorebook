{
  "name": "beyblade-x-scorebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" vite.config.mjs vitest.config.mts playwright.config.ts stryker.config.mjs scripts/check-public-build.mjs scripts/serve-react-build.mjs scripts/sync-part-names.mjs",
    "format:check": "prettier --check index.html package.json components.json tsconfig.json eslint.config.js vite.config.mjs vitest.config.mts playwright.config.ts stryker.config.mjs \"src/**/*.{ts,tsx}\" \"src/**/*.d.ts\" \"src/app/**/*.css\" \"tests/**/*.{ts,json}\" scripts/check-public-build.mjs scripts/serve-react-build.mjs scripts/sync-part-names.mjs \".github/workflows/*.yml\"",
    "check:build": "node scripts/check-public-build.mjs",
    "test": "npm run test:unit && node scripts/smoke-test.mjs && node scripts/validate-local-data.mjs",
    "test:unit": "vitest run",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "validate:data": "node scripts/validate-local-data.mjs",
    "summarize:data": "node scripts/summarize-local-data.mjs",
    "sync:part-names": "node scripts/sync-part-names.mjs",
    "migrate:collection": "node scripts/migrate-collection.mjs",
    "migrate:normalized": "node scripts/migrate-normalized-listings.mjs",
    "generate:wishlist": "node scripts/generate-wishlist.mjs",
    "audit:normalized": "node scripts/audit-normalized.mjs",
    "normalize:crawl": "node scripts/normalize-crawl.mjs",
    "gate:normalized": "node scripts/apply-normalized-gates.mjs",
    "report:candidates": "node scripts/report-crawl-candidates.mjs",
    "refresh:wishlist": "node scripts/refresh-wishlist.mjs",
    "export:catalogue": "node scripts/export-public-catalogue.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
