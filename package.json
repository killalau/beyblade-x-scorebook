{
  "name": "beyblade-x-scorebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:legacy": "node scripts/serve.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.mjs scripts/check-public-build.mjs",
    "format:check": "prettier --check react.html package.json components.json tsconfig.json eslint.config.js vite.config.mjs \"src/**/*.{ts,tsx}\" \"src/app/**/*.css\" scripts/check-public-build.mjs .github/workflows/react-migration.yml",
    "check:build": "node scripts/check-public-build.mjs",
    "test": "node scripts/smoke-test.mjs && node scripts/validate-local-data.mjs",
    "validate:data": "node scripts/validate-local-data.mjs",
    "summarize:data": "node scripts/summarize-local-data.mjs",
    "migrate:collection": "node scripts/migrate-collection.mjs",
    "migrate:normalized": "node scripts/migrate-normalized-listings.mjs",
    "generate:wishlist": "node scripts/generate-wishlist.mjs",
    "audit:normalized": "node scripts/audit-normalized.mjs",
    "normalize:crawl": "node scripts/normalize-crawl.mjs",
    "gate:normalized": "node scripts/apply-normalized-gates.mjs",
    "report:candidates": "node scripts/report-crawl-candidates.mjs",
    "refresh:wishlist": "node scripts/refresh-wishlist.mjs",
    "export:catalogue": "node scripts/export-public-catalogue.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
